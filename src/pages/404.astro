---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" semIndex>
  <section class="secao">
    <div class="container">
      <p class="rotulo">Erro 404</p>
      <h1>Esta página não existe.</h1>
      <p class="lead">O endereço pode ter mudado. Volte ao início ou fale diretamente comigo.</p>
      <p style="margin-top:2rem;display:flex;gap:.75rem;flex-wrap:wrap">
        <a class="btn btn--primario" href="/">Voltar ao início</a>
        <a class="btn btn--contorno" href="/#agendar">Agendar conversa</a>
      </p>
    </div>
  </section>
</Base>
