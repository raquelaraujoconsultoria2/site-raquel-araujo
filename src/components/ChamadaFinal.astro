---
interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = 'Quer saber se faz sentido para a sua empresa?',
  texto = 'A primeira conversa é para entender o seu momento. Sem compromisso.',
} = Astro.props;
---

<section class="secao secao--escura chamada">
  <div class="container conteudo">
    <div>
      <h2>{titulo}</h2>
      <p class="lead">{texto}</p>
    </div>
    <div class="acoes">
      <a href="/#agendar" class="btn btn--dourado">Agendar conversa</a>
      <a href="/#diagnostico" class="btn btn--contorno">Fazer o diagnóstico</a>
    </div>
  </div>
</section>

<style>
  .chamada {
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .conteudo {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .conteudo {
      grid-template-columns: 1.4fr 1fr;
    }
    .acoes {
      justify-content: flex-end;
    }
  }
  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  }
  .lead {
    margin: 0;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
