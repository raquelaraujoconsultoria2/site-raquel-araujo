---
// Seção pronta, mas só aparece quando SITE.mostrarResultados = true.
// Para ativar: preencher LOGOS (arquivos em /public/logos/) e DEPOIMENTOS.
import { SITE } from '../config';

const LOGOS: { nome: string; arquivo: string }[] = [
  // { nome: 'Empresa X', arquivo: '/logos/empresa-x.svg' },
];
const DEPOIMENTOS: { texto: string; nome: string; cargo: string }[] = [
  // { texto: '…', nome: 'Fulano de Tal', cargo: 'CEO, Empresa X' },
];
---

{
  SITE.mostrarResultados && (
    <section class="secao secao--clara" id="resultados">
      <div class="container">
        <div class="cabecalho-secao revelar">
          <p class="rotulo">Empresas e resultados</p>
          <h2>
            Quem já trabalha <em class="destaque">com método.</em>
          </h2>
        </div>
        {LOGOS.length > 0 && (
          <ul class="logos">
            {LOGOS.map((l) => (
              <li>
                <img src={l.arquivo} alt={l.nome} loading="lazy" />
              </li>
            ))}
          </ul>
        )}
        <div class="depoimentos">
          {DEPOIMENTOS.map((d) => (
            <figure class="revelar">
              <blockquote>“{d.texto}”</blockquote>
              <figcaption>
                <strong>{d.nome}</strong> {d.cargo}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .logos {
    list-style: none;
    margin: 0 0 3.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 3.5rem;
    align-items: center;
  }
  .logos img {
    height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }
  .depoimentos {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  figure {
    margin: 0;
    padding: 2rem;
    background: var(--creme);
    border-radius: 6px;
  }
  blockquote {
    margin: 0 0 1.5rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--petroleo);
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
  figcaption strong {
    display: block;
    color: var(--texto);
  }
</style>
