---
import { SITE } from '../config';
---

<div class="aviso" data-cookies hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
  <p>
    Usamos cookies de medição (Google Analytics) para entender como o site é usado. Você escolhe.{' '}
    <a href="/privacidade">Política de privacidade</a>
  </p>
  <div class="acoes">
    <button type="button" class="btn btn--contorno" data-recusar>Recusar</button>
    <button type="button" class="btn btn--primario" data-aceitar>Aceitar</button>
  </div>
</div>

<script is:inline define:vars={{ ga4: SITE.ga4 }}>
  (function () {
    var CHAVE = 'ra-cookies';
    var aviso = document.querySelector('[data-cookies]');
    function ler() {
      try { return localStorage.getItem(CHAVE); } catch (e) { return null; }
    }
    function gravar(v) {
      try { localStorage.setItem(CHAVE, v); } catch (e) {}
    }
    function carregarGA() {
      if (!ga4 || window.gtag) return;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', ga4, { anonymize_ip: true });
    }
    var escolha = ler();
    if (escolha === 'aceito') carregarGA();
    else if (!escolha && ga4) aviso.hidden = false;

    aviso.querySelector('[data-aceitar]').addEventListener('click', function () {
      gravar('aceito'); aviso.hidden = true; carregarGA();
    });
    aviso.querySelector('[data-recusar]').addEventListener('click', function () {
      gravar('recusado'); aviso.hidden = true;
    });
    document.querySelectorAll('[data-abrir-cookies]').forEach(function (b) {
      b.addEventListener('click', function () { aviso.hidden = false; });
    });
  })();
</script>

<style>
  .aviso {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    max-width: 34rem;
    padding: 1.25rem 1.5rem;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: 6px;
    box-shadow: var(--sombra);
    font-size: 0.92rem;
  }
  .aviso[hidden] {
    display: none;
  }
  .aviso p {
    margin-bottom: 1rem;
  }
  .acoes {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  .acoes .btn {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.88rem;
  }
</style>
