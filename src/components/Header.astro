---
import { MENU } from '../config';
import Logo from './Logo.astro';

const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---

<header class="topo" data-topo>
  <div class="container barra">
    <Logo />
    <nav class="nav" id="menu" aria-label="Menu principal">
      <ul>
        {
          MENU.map((item) => (
            <li>
              <a href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#agendar" class="btn btn--primario cta">Agendar conversa</a>
    </nav>
    <button class="abrir" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const topo = document.querySelector<HTMLElement>('[data-topo]')!;
  const botao = topo.querySelector<HTMLButtonElement>('.abrir')!;
  const alternar = (aberto: boolean) => {
    topo.classList.toggle('aberto', aberto);
    botao.setAttribute('aria-expanded', String(aberto));
    botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    document.body.style.overflow = aberto ? 'hidden' : '';
  };
  botao.addEventListener('click', () => alternar(!topo.classList.contains('aberto')));
  topo.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => alternar(false)));
  const rolar = () => topo.classList.toggle('rolado', window.scrollY > 8);
  rolar();
  window.addEventListener('scroll', rolar, { passive: true });
</script>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(245 243 238 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .topo.rolado {
    border-bottom-color: var(--linha);
  }
  /* backdrop-filter cria um novo contexto para position: fixed; desliga com o menu aberto */
  .topo.aberto {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--creme);
  }
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--texto);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-bottom-color: var(--dourado);
  }
  .cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.2rem;
    font-size: 0.88rem;
  }
  .abrir {
    display: none;
  }

  @media (max-width: 1023px) {
    .abrir {
      display: grid;
      place-content: center;
      gap: 7px;
      width: 44px;
      height: 44px;
      border: 0;
      background: none;
      cursor: pointer;
      position: relative;
      z-index: 2;
    }
    .abrir span {
      display: block;
      width: 24px;
      height: 1.5px;
      background: var(--petroleo);
      transition: transform 0.3s;
    }
    .aberto .abrir span:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }
    .aberto .abrir span:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: 4.75rem 0 0;
      height: calc(100dvh - 4.75rem);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 2rem;
      padding: 2rem var(--gutter);
      background: var(--creme);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.25s,
        visibility 0.25s;
    }
    .aberto .nav {
      visibility: visible;
      opacity: 1;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      font-family: var(--serif);
      font-size: 1.75rem;
      padding-block: 0.7rem;
      border-bottom: 1px solid var(--linha);
    }
    .cta {
      min-height: 3.25rem;
      font-size: 1rem;
    }
  }
</style>
