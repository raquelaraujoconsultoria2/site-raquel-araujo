---
import type { CollectionEntry } from 'astro:content';
interface Props {
  artigo: CollectionEntry<'artigos'>;
}
const { artigo } = Astro.props;
const { titulo, resumo, categoria, tipo, data, video } = artigo.data;
const dataFmt = data.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<article class="card">
  {
    tipo === 'video' && video && (
      <div class="miniatura">
        <img src={`https://i.ytimg.com/vi/${video}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
        <span class="play" aria-hidden="true" />
      </div>
    )
  }
  <p class="meta">
    <span>{tipo === 'video' ? 'Vídeo' : 'Artigo'} · {categoria}</span>
    <time datetime={data.toISOString()}>{dataFmt}</time>
  </p>
  <h3><a href={`/conteudos/${artigo.id}`}>{titulo}</a></h3>
  <p class="resumo">{resumo}</p>
  <span class="link-seta" aria-hidden="true">{tipo === 'video' ? 'Assistir' : 'Ler'}</span>
</article>

<style>
  .miniatura {
    position: relative;
    margin: -2rem -2rem 1.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px 6px 0 0;
    background: var(--petroleo);
  }
  .miniatura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 50%;
    background: rgb(19 47 51 / 0.85);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 22px;
    top: 17px;
    border-left: 16px solid var(--areia);
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: 6px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .card:hover {
    border-color: var(--dourado);
    transform: translateY(-2px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dourado-escuro);
  }
  .meta time {
    color: var(--texto-suave);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .resumo {
    color: var(--texto-suave);
    font-size: 0.97rem;
    margin-bottom: 1.5rem;
  }
  .link-seta {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
